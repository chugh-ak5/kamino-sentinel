# Solana RPC Configuration
# Production deployments should specify a dedicated RPC provider (Helius, Triton, QuickNode).
# Public endpoints are rate-limited and will fail large getProgramAccounts queries.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# RPC Timing and Retry Controls
RPC_TIMEOUT_SECONDS=8.0
RPC_TOTAL_BUDGET_SECONDS=20.0
RPC_MAX_RETRIES=3
RPC_BACKOFF_BASE_SECONDS=0.5
RPC_BACKOFF_MAX_SECONDS=8.0

# Alerting Channels (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300
ALERT_TIMEOUT_SECONDS=10.0

# Health Risk Thresholds
HEALTH_CRITICAL_THRESHOLD=1.05
HEALTH_WARNING_THRESHOLD=1.15
HEALTH_CAUTION_THRESHOLD=1.25

# Telemetry and Logging
POLL_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
LOG_JSON=false
